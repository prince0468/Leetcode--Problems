from collections import deque

class Solution:
    def bottomView(self, root):
        if not root:
            return []

        
        mp = {}

        
        q = deque()
        q.append((root, 0))

        while q:
            node, hd = q.popleft()

            
            mp[hd] = node.data

            if node.left:
                q.append((node.left, hd - 1))

            if node.right:
                q.append((node.right, hd + 1))

        ans = []

        
        for hd in sorted(mp):
            ans.append(mp[hd])

        return ans
