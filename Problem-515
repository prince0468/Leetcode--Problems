from collections import deque

class Solution:
    def largestValues(self, root):

        if not root:
            return []

        ans = []
        q = deque([root])

        while q:

            level_size = len(q)

            maximum = float("-inf")

            for _ in range(level_size):

                node = q.popleft()

                maximum = max(maximum, node.val)

                if node.left:
                    q.append(node.left)

                if node.right:
                    q.append(node.right)

            ans.append(maximum)

        return ans
