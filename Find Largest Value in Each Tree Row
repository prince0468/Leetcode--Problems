from collections import deque
class Solution:
    def largestValues(self, root):
      ans = []
      if root is None:
          return ans
          
      queue = deque([root])
      while queue:
          size = len(queue)
          level = []
          for _ in range(size):
            node = queue.popleft()
            level.append(node.val)
            if node.left:
                queue.append(node.left)
            if node.right:
                queue.append(node.right)
            
          ans.append(max(level))

      return ans   
          
