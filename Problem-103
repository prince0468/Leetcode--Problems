from collections import deque
class Solution:
    def zigzagLevelOrder(self, root):
      ans = []
      if root is None:
          return ans
          
      queue = deque([root])
      level_num = 1
      while queue:
        
          size = len(queue)
          level = []
          
          for _ in range(size):
            node = queue.popleft()
            level.append(node.val)
            if node.left:
                queue.append(node.left)
            if node.right:
                queue.append(node.right)
          if level_num % 2 == 0:
                level.reverse()
          ans.append(level)
          level_num += 1
      return ans   
          
