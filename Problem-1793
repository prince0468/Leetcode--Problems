class Solution:
    def maximumScore(self, nums: List[int], k: int) -> int:
        n = len(nums)

        left = right = k
        mini = nums[k]
        ans = mini

        while left > 0 or right < n - 1:

            if left == 0:
                right += 1
            elif right == n - 1:
                left -= 1
            elif nums[left - 1] > nums[right + 1]:
                left -= 1
            else:
                right += 1

            mini = min(mini, nums[left], nums[right])
            ans = max(ans, mini * (right - left + 1))

        return ans
