from collections import deque

class Solution:
    def rightSideView(self, root):
      ans = []
      if root is None:
          return ans
      queue = deque([root])
      while queue:
            size = len(queue)

            level = []

            for i in range(size):

                node = queue.popleft()
                if i == size - 1:
                    ans.append(node.val)
                level.append(node.val)

                if node.left:
                    queue.append(node.left)

                if node.right:
                    queue.append(node.right)

            

      return ans
        
