from collections import deque
class solution:
   def levelOrder(self,root):
     ans = []
     if root is None:
        return ans
     queue = deque(root)
     while queue:
        size = len(queue)
        level = []
        for _ in range(size):
          node = queue.popleft()
          level.appned(node.val)
          
          if node.left:
              queue.append(node.left)
          if node.right:
              queue.append(node.right)
        ans.reverse
     return ans
    
